# Copy this file to .env and fill it in. Never commit .env (it is gitignored).

# MySQL connection string. The tests use a sibling database named "teachlink_test" derived from
# this one, so the user needs permission to create databases (or create it once by hand).
DATABASE_URL="mysql://teachlink_user:CHANGE_ME@localhost:3306/teachlink"

PORT=5000

# Secrets that sign login tokens. Anyone who knows them can forge a login, including an admin's.
# Must be long, random and DIFFERENT from each other; in production the server refuses to start
# if they are placeholders or shorter than 32 characters. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Origin(s) allowed to call the API with cookies. Comma-separate several. Required in production.
FRONTEND_URL=http://localhost:5173

# Set to the number of reverse proxies in front of the app (usually 1 on a hosting platform) so
# rate limiting sees each visitor's real IP. Leave unset when running without a proxy.
# TRUST_PROXY=1

# Optional: used by `npm run prisma:seed` to create the first admin. All three are required
# together; the password needs at least 8 characters. Remove ADMIN_PASSWORD afterwards if you like.
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
