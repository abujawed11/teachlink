generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ContactPreference {
  PLATFORM_ONLY
  PHONE
  WHATSAPP
}

enum QualificationType {
  DEGREE
  CERTIFICATION
  OTHER
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  username        String     @unique
  password        String
  name            String
  phone           String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  teacherProfile TeacherProfile?
}

model TeacherProfile {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug   String @unique

  headline             String?
  bio                  String? @db.Text
  photoUrl             String?
  gender               Gender?
  experienceYears      Int?
  qualificationSummary String?

  country String?
  state   String?
  city    String?
  area    String?
  pincode String?

  onlineAvailable            Boolean @default(false)
  offlineAvailable           Boolean @default(false)
  homeTuitionAvailable       Boolean @default(false)
  studentCanVisit            Boolean @default(false)
  groupTuitionAvailable      Boolean @default(false)
  individualTuitionAvailable Boolean @default(false)
  demoClassAvailable         Boolean @default(false)
  teachingRadiusKm           Int?

  feeMin Int?
  feeMax Int?

  contactPreference ContactPreference @default(PLATFORM_ONLY)

  isPublished  Boolean @default(false)
  isVerified   Boolean @default(false)
  profileViews Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects       TeacherSubject[]
  grades         TeacherGrade[]
  boards         TeacherBoard[]
  languages      TeacherLanguage[]
  qualifications TeacherQualification[]
  experiences    TeacherExperience[]
  availabilities TeacherAvailability[]

  @@index([city])
  @@index([isPublished])
}

model Subject {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  teachers TeacherSubject[]
}

model Grade {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  teachers TeacherGrade[]
}

model Board {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  teachers TeacherBoard[]
}

model Language {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers TeacherLanguage[]
}

model TeacherSubject {
  teacherProfileId Int
  subjectId        Int

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, subjectId])
}

model TeacherGrade {
  teacherProfileId Int
  gradeId          Int

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  grade          Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, gradeId])
}

model TeacherBoard {
  teacherProfileId Int
  boardId          Int

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  board          Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, boardId])
}

model TeacherLanguage {
  teacherProfileId Int
  languageId       Int

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  language       Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, languageId])
}

model TeacherQualification {
  id               Int               @id @default(autoincrement())
  teacherProfileId Int
  teacherProfile   TeacherProfile    @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  title            String
  institution      String?
  yearCompleted    Int?
  type             QualificationType @default(DEGREE)
  createdAt        DateTime          @default(now())
}

model TeacherExperience {
  id               Int            @id @default(autoincrement())
  teacherProfileId Int
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  institutionName  String
  role             String?
  startDate        DateTime?
  endDate          DateTime?
  description      String?        @db.Text
  createdAt        DateTime       @default(now())
}

model TeacherAvailability {
  id               Int            @id @default(autoincrement())
  teacherProfileId Int
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  dayOfWeek        DayOfWeek
  startTime        String
  endTime          String
  createdAt        DateTime       @default(now())
}
